{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "description": "Vcpkg toolchain (manifest mode). Requires the VCPKG_ROOT environment variable.",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
      }
    },
    {
      "name": "windows-clangcl",
      "displayName": "Windows (clang-cl, Ninja Multi-Config)",
      "description": "Uses the standalone LLVM clang-cl from PATH. No Developer Prompt required; the clang driver locates MSVC and the Windows SDK itself.",
      "inherits": "vcpkg-base",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/windows-clangcl",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-vs-clangcl",
      "displayName": "Windows (Visual Studio, ClangCL toolset)",
      "description": "Visual Studio generator using VS's bundled ClangCL toolset.",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 18 2026",
      "toolset": "ClangCL",
      "binaryDir": "${sourceDir}/out/windows-vs-clangcl"
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/out/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/out/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux RelWithDebInfo",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/out/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-minsizerel",
      "displayName": "Linux MinSizeRel",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/out/MinSizeRel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clangcl-debug",
      "configurePreset": "windows-clangcl",
      "configuration": "Debug"
    },
    {
      "name": "windows-clangcl-release",
      "configurePreset": "windows-clangcl",
      "configuration": "Release"
    },
    {
      "name": "windows-vs-clangcl-debug",
      "configurePreset": "windows-vs-clangcl",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ]
}
